{
  "expo": {
    "name": "Nébula",
    "slug": "nebula",
    "scheme": "nebula",
    "version": "1.1.11",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.louca.nebula",
      "versionCode": 13,
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_PROMOTED_NOTIFICATIONS",
        "android.permission.DETECT_SCREEN_CAPTURE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "expo-secure-store",
      "react-native-libsodium",
      [
        "expo-camera",
        {
          "cameraPermission": "Nébula utilise la caméra pour lire le QR code de vos contacts et prendre des photos et des vidéos.",
          "microphonePermission": "Nébula utilise le micro pour enregistrer le son de vos vidéos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.4.0",
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-sharing",
      "expo-video",
      "./plugins/with-release-signing",
      "./plugins/with-dark-launch",
      "./plugins/with-short-native-build",
      "./plugins/with-share-intent",
      "./plugins/with-file-service",
      "./plugins/with-call-pip",
      "./plugins/with-screen-share",
      "./plugins/with-pip-alive",
      "./plugins/with-notification-icon",
      "./plugins/with-stamp-fonts",
      "./plugins/with-no-emoji-compat",
      "./plugins/with-prepared-text-layout",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-image-picker",
      "@maplibre/maplibre-react-native",
      [
        "expo-audio",
        {
          "microphonePermission": "Nébula utilise le micro pour enregistrer vos messages vocaux.",
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
